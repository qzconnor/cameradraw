{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Neue Funktionen" },
            { "type": "fix", "section": "Fehlerbehebungen" },
            { "type": "perf", "section": "Schneller" },
            { "type": "revert", "section": "Zurückgenommen" },
            { "type": "refactor", "hidden": true },
            { "type": "docs", "hidden": true },
            { "type": "style", "hidden": true },
            { "type": "test", "hidden": true },
            { "type": "build", "hidden": true },
            { "type": "ci", "hidden": true },
            { "type": "chore", "hidden": true }
          ]
        }
      }
    ],
    ["@semantic-release/npm", { "npmPublish": false }],
    ["@semantic-release/exec", { "prepareCmd": "npm run release:build" }],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/*-setup.exe", "label": "Windows-Installer" },
          { "path": "dist/*-setup.exe.blockmap" },
          { "path": "dist/latest.yml" }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
