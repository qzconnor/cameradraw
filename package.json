{
  "name": "cameradraw",
  "version": "1.0.0",
  "private": true,
  "description": "Kamera einfrieren, darauf zeichnen und speichern",
  "main": "./out/main/index.js",
  "author": "Connor Breuer",
  "repository": {
    "type": "git",
    "url": "https://github.com/qzconnor/cameradraw.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "test:e2e": "electron-vite build --outDir out-e2e && playwright test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:service": "node scripts/build-service.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && npm run build:service && electron-builder --win",
    "release:build": "npm run build && npm run build:service && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@playwright/test": "1.64.0",
    "@semantic-release/exec": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fabric": "^7.4.0",
    "pinia": "^4.1.0",
    "prettier": "^3.9.10",
    "reka-ui": "^2.11.0",
    "semantic-release": "^25.0.9",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  },
  "productName": "CameraDraw"
}
